# Copy to .env for local development. Never commit .env.

# Required. Author base URL and a non-default technical user.
AEM_HOST=http://localhost:4502
AEM_SERVICE_USER=mcp-technical
AEM_SERVICE_PASSWORD=change-me

# Repository roots this process may touch (prefix-matched by JCR segment).
AEM_SITES_ROOT=/content
AEM_ASSETS_ROOT=/content/dam
AEM_TEMPLATES_ROOT=/conf
AEM_XF_ROOT=/content/experience-fragments
AEM_DEFAULT_AGENT=publish
AEM_DEFAULT_CONTAINER=root
AEM_DEFAULT_PAGE_RESOURCE_TYPE=core/wcm/components/page/v3/page
AEM_ALLOWED_COMPONENTS=text,image,teaser,button,list,title,separator
AEM_QUERY_MAX_LIMIT=100
AEM_QUERY_DEFAULT_LIMIT=20
AEM_QUERY_TIMEOUT=30000
AEM_MAX_DEPTH=5
AEM_MAX_UPLOAD_BYTES=26214400
AEM_MAX_CONCURRENT_WRITES=4

# Optional HTTP gateway (stdio does not need these).
HTTP_ENABLED=true
HOST=127.0.0.1
GATEWAY_PORT=3001
MCP_API_KEY=replace-with-long-random-value
# Or HTTP Basic instead of API key:
# MCP_USERNAME=mcp-http
# MCP_PASSWORD=replace-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

NODE_ENV=development
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false
LOG_DIRECTORY=./logs
